QUOTA_IP_SALT=replace-with-a-long-random-secret
TRUSTED_PROXY_COUNT=0

# --- Model connectors -------------------------------------------------------
# LLM_PROVIDER: ollama (default) | none
# Web chat answers do not use LLM_PROVIDER: they come from LEGAL_RAG_URL's /v1/chat,
# whose model is LEGAL_RAG__LLM__BACKEND / LEGAL_RAG__LLM__MODEL (restart the API after changing).
# EMBEDDING_PROVIDER: ollama (default) | none
# Both default to Ollama, so the app runs fully locally and needs no API key.
# "none" disables that connector explicitly and is not an error: it is how you
# run the app with AI turned off.
# Changing EMBEDDING_PROVIDER switches to a different Chroma collection and
# requires re-ingesting your documents; the old collection is left untouched.
LLM_PROVIDER=
EMBEDDING_PROVIDER=

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_EMBED_MODEL=bge-m3
# Qwen3 degrades and repeats under greedy decoding, so do not set this to 0.
OLLAMA_TEMPERATURE=0.7
# Leave unset. Set to true only to see the model's thinking in traces.
OLLAMA_REASONING=

# Context window of the answer model, in tokens, for both apps (default 12288). Measured
# 2026-10-06: prompts reach 6,600 tokens, 9,250 with three passages of case documents, plus
# up to 2,048 output tokens. 12288 uses 7.8 GB of an 8 GB card with the reranker loaded.
# Uncomment to change it (an empty value is an error), then restart both apps. OLLAMA_NUM_CTX overrides it for the Flask app alone;
# keep the two equal or Ollama reloads the model on every switch.
# LEGAL_RAG__LLM__NUM_CTX=12288

# Passages of the user's uploaded case documents sent with a chat turn: how many (at most 3),
# how long each, and the lowest relevance (0 to 1) that still counts as about the question.
CASE_DOCUMENT_LIMIT=3
CASE_DOCUMENT_CHARS=1000
CASE_DOCUMENT_MIN_SCORE=0.25


# --- Storage ----------------------------------------------------------------
APP_STATE_DB=sqlite_db/app_state.db
RAG_PERSIST_DIR=./chroma_db

# --- Runtime ----------------------------------------------------------------
# SECRET_KEY is required in production; a random key is generated otherwise,
# which invalidates every session on restart.
SECRET_KEY=
APP_ENV=
DAILY_AI_REQUEST_LIMIT=20

# LangSmith tracing. Off unless LANGSMITH_TRACING is set to a truthy value
# (1/true/yes/on); an empty value keeps it off.
# Privacy: enabling tracing uploads full prompts, the retrieved document text
# and model answers to LangSmith. This app stores users' chat history
# and uploaded files, so treat it as sending user personal data to a third
# party and enable it only in environments where that is acceptable.
LANGSMITH_TRACING=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=

# law.go.kr open API key (the OC value you registered at open.law.go.kr). Used only by
# the statute fetch script; without it the script falls back to OC=test.
LAW_GO_KR_OC=
